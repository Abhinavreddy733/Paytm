// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Users - username, password, balance, transactions
//Balance - userId, amount
//Transactions - senderId, receiverId, amount, date, transactionStatus
//

model User {
  id                   Int            @id @default(autoincrement())
  username             String
  password             String
  phoneNumber          Int?           @unique
  balance              Int            @default(0)
  accountPin           Int
  sentTransactions     Transactions[] @relation("SentTransactions")
  receivedTransactions Transactions[] @relation("ReceivedTransactions")
}

model Transactions {
  id                  Int                   @id @default(autoincrement())
  senderPhoneNumber   Int
  receiverPhoneNumber Int
  amount              Int
  transactionStatus   transactionStatusEnum
  transactionTime     DateTime
  sender              User                  @relation("SentTransactions", fields: [senderPhoneNumber], references: [phoneNumber])
  receiver            User                  @relation("ReceivedTransactions", fields: [receiverPhoneNumber], references: [phoneNumber])
}

enum transactionStatusEnum {
  FAILED
  PROGRESS
  SUCCESS
}
